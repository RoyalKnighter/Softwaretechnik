<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:smartFactoryApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="smartFactoryApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" 
        Height="600" 
        Title="smartFactoryApp" >
       

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
     <Image Source="avares://smartFactoryApp/Assets/factory_plan.png"
           Stretch="None"/>
 
    <Canvas x:Name="canvasFactory" HorizontalAlignment="Left" Height="600" VerticalAlignment="Top" Width="900" >

        <Grid Height="40" Width="120" Canvas.Left="730" Canvas.Top="300">
            <Button x:Name="StartBrickButton" Content="Start" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" Width="55" FontSize="16" Click="StartBrick_Click"/>
            <Button x:Name="StopBrickButton" Content="Stop" HorizontalAlignment="Right" VerticalAlignment="Top" Height="40" Width="55" FontSize="16" Click="StopBrick_Click" />
        </Grid>

        <Grid Height="40" Width="120" Canvas.Left="730" Canvas.Top="350">
            <RepeatButton x:Name="TurnLeftButton" Content="↺" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" Width="40" FontSize="16" Click="TurnLeft_Click"/>
            <RepeatButton x:Name="TurnRightButton" Content="↻" HorizontalAlignment="Right" VerticalAlignment="Top" Height="40" Width="40" FontSize="16" Click="TurnRight_Click" />
        </Grid>

        <Grid Height="40" Width="120" Canvas.Left="730" Canvas.Top="400">
            <RepeatButton x:Name="ForwardButton" Content="Forward" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" Width="55" FontSize="16" Click="MoveForward_Click"/>
            <RepeatButton x:Name="BackwardButton" Content="Backward" HorizontalAlignment="Right" VerticalAlignment="Top" Height="40" Width="55" FontSize="16" Click="MoveBackward_Click" />
        </Grid>
      
        <Grid Height="120" Width="120" Canvas.Left="730" Canvas.Top="450">
            <RepeatButton x:Name="UpButton" Content="↑" HorizontalAlignment="Center" VerticalAlignment="Top" Height="40" Width="40" FontSize="16" Click="MoveUp_Click"/>
            <RepeatButton x:Name="DownButton" Content="↓" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="40" Width="40" FontSize="16" Click="MoveDown_Click" />
            <RepeatButton x:Name="LeftButton" Content="←" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Width="40" FontSize="16" Click="MoveLeft_Click" />
            <RepeatButton x:Name="RightButton" Content="→" HorizontalAlignment="Right" VerticalAlignment="Center" Height="40" Width="40" FontSize="16" Click="MoveRight_Click" />

            <RepeatButton x:Name="UpLeftButton" Content="↖" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" Width="40" FontSize="16" Click="MoveUpLeft_Click"/>
            <RepeatButton x:Name="DownLeftButton" Content="↙" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="40" Width="40" FontSize="16" Click="MoveDownLeft_Click" />
            <RepeatButton x:Name="UpRightButton" Content="↗" HorizontalAlignment="Right" VerticalAlignment="Top" Height="40" Width="40" FontSize="16" Click="MoveUpRight_Click" />
            <RepeatButton x:Name="DownRightButton" Content="↘" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="40" Width="40" FontSize="16" Click="MoveDownRight_Click" />
        </Grid>
        <Rectangle x:Name="brickRed0" Width="12" Height="12" Fill="Red" Stroke="Black"
                   Canvas.Left="{Binding BricksView[0].X}" Canvas.Top="{Binding BricksView[0].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[0].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
         <Rectangle x:Name="brickRed1" Width="12" Height="12" Fill="Red" Stroke="Black"
                   Canvas.Left="{Binding BricksView[1].X}" Canvas.Top="{Binding BricksView[1].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[1].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
         <Rectangle x:Name="brickRed2" Width="12" Height="12" Fill="Red" Stroke="Black"
                   Canvas.Left="{Binding BricksView[2].X}" Canvas.Top="{Binding BricksView[2].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[2].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
         <Rectangle x:Name="brickRed3" Width="12" Height="12" Fill="Red" Stroke="Black"
                   Canvas.Left="{Binding BricksView[3].X}" Canvas.Top="{Binding BricksView[3].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[3].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickBlue0" Width="12" Height="12" Fill="Blue" Stroke="Black"
                   Canvas.Left="{Binding BricksView[4].X}" Canvas.Top="{Binding BricksView[4].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[4].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
         <Rectangle x:Name="brickBlue1" Width="12" Height="12" Fill="Blue" Stroke="Black"
                   Canvas.Left="{Binding BricksView[5].X}" Canvas.Top="{Binding BricksView[5].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[5].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
         <Rectangle x:Name="brickBlue2" Width="12" Height="12" Fill="Blue" Stroke="Black"
                   Canvas.Left="{Binding BricksView[6].X}" Canvas.Top="{Binding BricksView[6].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[6].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
         <Rectangle x:Name="brickBlue3" Width="12" Height="12" Fill="Blue" Stroke="Black"
                   Canvas.Left="{Binding BricksView[7].X}" Canvas.Top="{Binding BricksView[7].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[7].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickGreen0" Width="12" Height="12" Fill="Green" Stroke="Black"
                   Canvas.Left="{Binding BricksView[8].X}" Canvas.Top="{Binding BricksView[8].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[8].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
         <Rectangle x:Name="brickGreen1" Width="12" Height="12" Fill="Green" Stroke="Black"
                   Canvas.Left="{Binding BricksView[9].X}" Canvas.Top="{Binding BricksView[9].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[9].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
         <Rectangle x:Name="brickGreen2" Width="12" Height="12" Fill="Green" Stroke="Black"
                   Canvas.Left="{Binding BricksView[10].X}" Canvas.Top="{Binding BricksView[10].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[10].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
         <Rectangle x:Name="brickGreen3" Width="12" Height="12" Fill="Green" Stroke="Black"
                   Canvas.Left="{Binding BricksView[11].X}" Canvas.Top="{Binding BricksView[11].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[11].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickYellow0" Width="12" Height="12" Fill="Yellow" Stroke="Black"
                   Canvas.Left="{Binding BricksView[12].X}" Canvas.Top="{Binding BricksView[12].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[12].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
         <Rectangle x:Name="brickYellow1" Width="12" Height="12" Fill="Yellow" Stroke="Black"
                   Canvas.Left="{Binding BricksView[13].X}" Canvas.Top="{Binding BricksView[13].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[13].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
         <Rectangle x:Name="brickYellow2" Width="12" Height="12" Fill="Yellow" Stroke="Black"
                   Canvas.Left="{Binding BricksView[14].X}" Canvas.Top="{Binding BricksView[14].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[14].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
         <Rectangle x:Name="brickYellow3" Width="12" Height="12" Fill="Yellow" Stroke="Black"
                   Canvas.Left="{Binding BricksView[15].X}" Canvas.Top="{Binding BricksView[15].Y}" >
                   <Rectangle.RenderTransform><RotateTransform Angle="{Binding BricksView[15].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>




        <Rectangle x:Name="RobotRectangle" Canvas.Left="{Binding RobotX}" Canvas.Top="{Binding RobotY}"
                Width="70" Height="50" Stroke="Black">
            <Rectangle.Fill>
                <ImageBrush Source="avares://smartFactoryApp/Assets/robot.png"/>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding RobotAngle}"/>
            </Rectangle.RenderTransform>
        </Rectangle>

        <Image Source="avares://smartFactoryApp/Assets/LueftungRot.png"
            Canvas.Left="50" Canvas.Top="90"
            Width="100" Height="22"
            RenderTransformOrigin="50%,50%">
            <Image.RenderTransform>
                <RotateTransform Angle="315" />
            </Image.RenderTransform>
        </Image>

        <Image Source="avares://smartFactoryApp/Assets/LueftungBlau.png"
            Canvas.Left="440" Canvas.Top="90"
            Width="100" Height="22"
            RenderTransformOrigin="50%,50%">
            <Image.RenderTransform>
                <RotateTransform Angle="45" />
            </Image.RenderTransform>
        </Image>

        <Image Source="avares://smartFactoryApp/Assets/LueftungGruen.png"
            Canvas.Left="440" Canvas.Top="490"
            Width="100" Height="22"
            RenderTransformOrigin="50%,50%">
            <Image.RenderTransform>
                <RotateTransform Angle="135" />
            </Image.RenderTransform>
        </Image>

        <Image Source="avares://smartFactoryApp/Assets/LueftungGelb.png"
            Canvas.Left="50" Canvas.Top="490"
            Width="100" Height="22"
            RenderTransformOrigin="50%,50%">
            <Image.RenderTransform>
                <RotateTransform Angle="225" />
            </Image.RenderTransform>
        </Image>

        <TextBox x:Name="PositionTextBoxX" Canvas.Left="100" Canvas.Top="100" Width="20" Height="20" FontSize="20" IsReadOnly="True" Text="{Binding RobotX}" />
        <TextBox x:Name="PositionTextBoxY" Canvas.Left="100" Canvas.Top="150" Width="20" Height="20" FontSize="20" IsReadOnly="True" Text="{Binding RobotY}" />
        <TextBox Canvas.Left="100" Canvas.Top="200" Width="20" Height="20" FontSize="20" IsReadOnly="True" Text="{Binding RobotAngle}" />
    </Canvas>
  
</Grid>

</Window>
