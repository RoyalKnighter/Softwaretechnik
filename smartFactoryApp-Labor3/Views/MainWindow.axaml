<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:smartFactoryApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="smartFactoryApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" 
        Height="600" 
        Title="smartFactoryApp" >
       

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Image Source="avares://smartFactoryApp/Assets/factory_plan.png" Stretch="None"/>

    <Canvas x:Name="canvasFactory" HorizontalAlignment="Left" Height="600" VerticalAlignment="Top" Width="900">

        <!-- Timer für die Legosteine -->
        <Grid Height="40" Width="120" Canvas.Left="730" Canvas.Top="300">
            <Button x:Name="StartTimerButton" Content="Start" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" Width="55" FontSize="16" Click="StartTimer_Click"/>
            <Button x:Name="StopTimerButton" Content="Stop" HorizontalAlignment="Right" VerticalAlignment="Top" Height="40" Width="55" FontSize="16" Click="StopTimer_Click"/>
        </Grid>

        <!-- Drehen -->
        <Grid Height="40" Width="120" Canvas.Left="730" Canvas.Top="350">
            <RepeatButton x:Name="RotateLeftButton" Content="↺" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" Width="40" FontSize="16" Click="MoveRotateLeft_Click"/>
            <Button x:Name="ResetRotationButton" Content="0°" HorizontalAlignment="Center" VerticalAlignment="Top" Height="40" Width="40" FontSize="14" Click="ResetRotation_Click"/>
            <RepeatButton x:Name="RotateRightButton" Content="↻" HorizontalAlignment="Right" VerticalAlignment="Top" Height="40" Width="40" FontSize="16" Click="MoveRotateRight_Click"/>
        </Grid>

        <!-- Fahren -->
        <Grid Height="120" Width="120" Canvas.Left="730" Canvas.Top="450">
            <RepeatButton x:Name="UpLeftButton" Content="↖" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" Width="40" FontSize="16" Click="MoveUpLeft_Click"/>
            <RepeatButton x:Name="UpButton" Content="↑" HorizontalAlignment="Center" VerticalAlignment="Top" Height="40" Width="40" FontSize="16" Click="MoveUp_Click"/>
            <RepeatButton x:Name="UpRightButton" Content="↗" HorizontalAlignment="Right" VerticalAlignment="Top" Height="40" Width="40" FontSize="16" Click="MoveUpRight_Click"/>
            <RepeatButton x:Name="LeftButton" Content="←" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Width="40" FontSize="16" Click="MoveLeft_Click"/>
            <Button x:Name="StopButton" Content="■" HorizontalAlignment="Center" VerticalAlignment="Center" Height="40" Width="40" FontSize="16" Click="Stop_Click"/>
            <RepeatButton x:Name="RightButton" Content="→" HorizontalAlignment="Right" VerticalAlignment="Center" Height="40" Width="40" FontSize="16" Click="MoveRight_Click"/>
            <RepeatButton x:Name="DownLeftButton" Content="↙" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="40" Width="40" FontSize="16" Click="MoveDownLeft_Click"/>
            <RepeatButton x:Name="DownButton" Content="↓" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="40" Width="40" FontSize="16" Click="MoveDown_Click"/>
            <RepeatButton x:Name="DownRightButton" Content="↘" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="40" Width="40" FontSize="16" Click="MoveDownRight_Click"/>
        </Grid>

        <!-- Produktionslinien -->
        <Image Source="avares://smartFactoryApp/Assets/LueftungRot.png"
               Canvas.Left="{Binding ProductionRedX}" Canvas.Top="{Binding ProductionRedY}"
               Width="100" Height="22" RenderTransformOrigin="50%,50%">
            <Image.RenderTransform><RotateTransform Angle="{Binding ProductionRedAngle}"/></Image.RenderTransform>
        </Image>
        <Image Source="avares://smartFactoryApp/Assets/LueftungBlau.png"
               Canvas.Left="{Binding ProductionBlueX}" Canvas.Top="{Binding ProductionBlueY}"
               Width="100" Height="22" RenderTransformOrigin="50%,50%">
            <Image.RenderTransform><RotateTransform Angle="{Binding ProductionBlueAngle}"/></Image.RenderTransform>
        </Image>
        <Image Source="avares://smartFactoryApp/Assets/LueftungGruen.png"
               Canvas.Left="{Binding ProductionGreenX}" Canvas.Top="{Binding ProductionGreenY}"
               Width="100" Height="22" RenderTransformOrigin="50%,50%">
            <Image.RenderTransform><RotateTransform Angle="{Binding ProductionGreenAngle}"/></Image.RenderTransform>
        </Image>
        <Image Source="avares://smartFactoryApp/Assets/LueftungGelb.png"
               Canvas.Left="{Binding ProductionYellowX}" Canvas.Top="{Binding ProductionYellowY}"
               Width="100" Height="22" RenderTransformOrigin="50%,50%">
            <Image.RenderTransform><RotateTransform Angle="{Binding ProductionYellowAngle}"/></Image.RenderTransform>
        </Image>

        <!-- Legosteine -->
        <Rectangle Width="12" Height="12" Fill="Red" Stroke="Black"
                   Canvas.Left="{Binding RedBricks[0].X}" Canvas.Top="{Binding RedBricks[0].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding RedBricks[0].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Red" Stroke="Black"
                   Canvas.Left="{Binding RedBricks[1].X}" Canvas.Top="{Binding RedBricks[1].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding RedBricks[1].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Red" Stroke="Black"
                   Canvas.Left="{Binding RedBricks[2].X}" Canvas.Top="{Binding RedBricks[2].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding RedBricks[2].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Red" Stroke="Black"
                   Canvas.Left="{Binding RedBricks[3].X}" Canvas.Top="{Binding RedBricks[3].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding RedBricks[3].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Blue" Stroke="Black"
                   Canvas.Left="{Binding BlueBricks[0].X}" Canvas.Top="{Binding BlueBricks[0].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding BlueBricks[0].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Blue" Stroke="Black"
                   Canvas.Left="{Binding BlueBricks[1].X}" Canvas.Top="{Binding BlueBricks[1].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding BlueBricks[1].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Blue" Stroke="Black"
                   Canvas.Left="{Binding BlueBricks[2].X}" Canvas.Top="{Binding BlueBricks[2].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding BlueBricks[2].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Blue" Stroke="Black"
                   Canvas.Left="{Binding BlueBricks[3].X}" Canvas.Top="{Binding BlueBricks[3].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding BlueBricks[3].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Green" Stroke="Black"
                   Canvas.Left="{Binding GreenBricks[0].X}" Canvas.Top="{Binding GreenBricks[0].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding GreenBricks[0].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Green" Stroke="Black"
                   Canvas.Left="{Binding GreenBricks[1].X}" Canvas.Top="{Binding GreenBricks[1].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding GreenBricks[1].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Green" Stroke="Black"
                   Canvas.Left="{Binding GreenBricks[2].X}" Canvas.Top="{Binding GreenBricks[2].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding GreenBricks[2].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Green" Stroke="Black"
                   Canvas.Left="{Binding GreenBricks[3].X}" Canvas.Top="{Binding GreenBricks[3].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding GreenBricks[3].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Yellow" Stroke="Black"
                   Canvas.Left="{Binding YellowBricks[0].X}" Canvas.Top="{Binding YellowBricks[0].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding YellowBricks[0].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Yellow" Stroke="Black"
                   Canvas.Left="{Binding YellowBricks[1].X}" Canvas.Top="{Binding YellowBricks[1].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding YellowBricks[1].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Yellow" Stroke="Black"
                   Canvas.Left="{Binding YellowBricks[2].X}" Canvas.Top="{Binding YellowBricks[2].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding YellowBricks[2].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="12" Height="12" Fill="Yellow" Stroke="Black"
                   Canvas.Left="{Binding YellowBricks[3].X}" Canvas.Top="{Binding YellowBricks[3].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding YellowBricks[3].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>

        <!-- Roboter -->
        <Rectangle x:Name="RobotRectangle" Canvas.Left="{Binding RobotX}" Canvas.Top="{Binding RobotY}"
                   Width="70" Height="50" Stroke="Black">
            <Rectangle.Fill>
                <ImageBrush Source="avares://smartFactoryApp/Assets/robot.png"/>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding RobotAngle}"/>
            </Rectangle.RenderTransform>
        </Rectangle>

        <TextBox x:Name="PositionTextBoxX" Canvas.Left="100" Canvas.Top="100" Width="20" Height="20" FontSize="20" IsReadOnly="True" Text="{Binding RobotX}"/>
        <TextBox x:Name="PositionTextBoxY" Canvas.Left="100" Canvas.Top="150" Width="20" Height="20" FontSize="20" IsReadOnly="True" Text="{Binding RobotY}"/>
        <TextBox x:Name="AngleTextBox" Canvas.Left="100" Canvas.Top="200" Width="20" Height="20" FontSize="20" IsReadOnly="True" Text="{Binding RobotAngle}"/>
    </Canvas>

    </Grid>

</Window>
